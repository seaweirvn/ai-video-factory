{
  "name": "AIVF 01 素材摄取",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "trg-ingest",
      "name": "每6小时",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AIVF_BASE_URL }}/materials/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AIVF_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"country\": \"VN\"\n}",
        "options": {}
      },
      "id": "start-ingest",
      "name": "启动摄取",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "wait-ingest",
      "name": "等待",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        120,
        0
      ],
      "webhookId": "aivf-ingest-wait"
    },
    {
      "parameters": {
        "url": "={{ $env.AIVF_BASE_URL }}/jobs/{{ $('启动摄取').item.json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AIVF_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "poll-ingest",
      "name": "查询 job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-ingest-done",
      "name": "完成?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {},
      "id": "done-ingest",
      "name": "结束",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        780,
        -100
      ]
    }
  ],
  "connections": {
    "每6小时": {
      "main": [
        [
          {
            "node": "启动摄取",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "启动摄取": {
      "main": [
        [
          {
            "node": "等待",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "等待": {
      "main": [
        [
          {
            "node": "查询 job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "查询 job": {
      "main": [
        [
          {
            "node": "完成?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "完成?": {
      "main": [
        [
          {
            "node": "结束",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "等待",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
