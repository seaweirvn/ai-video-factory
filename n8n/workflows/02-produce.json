{
  "name": "AIVF 02 每日生产",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 2
            }
          ]
        }
      },
      "id": "trg-produce",
      "name": "每天02点",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AIVF_BASE_URL }}/produce",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AIVF_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"products\": [],\n  \"count\": 3,\n  \"upload\": true,\n  \"generate_content\": true\n}",
        "options": {}
      },
      "id": "start-produce",
      "name": "启动生产",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "id": "wait-produce",
      "name": "等待",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        120,
        0
      ],
      "webhookId": "aivf-produce-wait"
    },
    {
      "parameters": {
        "url": "={{ $env.AIVF_BASE_URL }}/jobs/{{ $('启动生产').item.json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AIVF_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "poll-produce",
      "name": "查询 job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-produce-done",
      "name": "完成?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {},
      "id": "done-produce",
      "name": "结束",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        780,
        -100
      ]
    }
  ],
  "connections": {
    "每天02点": {
      "main": [
        [
          {
            "node": "启动生产",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "启动生产": {
      "main": [
        [
          {
            "node": "等待",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "等待": {
      "main": [
        [
          {
            "node": "查询 job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "查询 job": {
      "main": [
        [
          {
            "node": "完成?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "完成?": {
      "main": [
        [
          {
            "node": "结束",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "等待",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
