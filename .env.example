# ===== 服务 =====
APP_NAME=ai-video-factory
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# 控制层调用服务层时携带的密钥（n8n -> API）
API_KEY=change-me

# ===== 工作区 / 数据目录 =====
WORKSPACE_DIR=workspace
LOG_DIR=logs
DATA_DIR=data

# ===== 飞书（当前 VN，后续国家按 FEISHU_{CODE}_* 扩展）=====
FEISHU_VN_APP_ID=your_feishu_vn_app_id
FEISHU_VN_APP_SECRET=your_feishu_vn_app_secret
FEISHU_VN_BITABLE_APP_TOKEN=your_vn_bitable_app_token
# 素材库在“营销”知识库多维表格下（app_token 与主 bitable 不同；可用脚本 wikifields 解析 wiki 节点得到）
FEISHU_VN_MATERIAL_APP_TOKEN=
# 各业务表 ID
FEISHU_VN_MATERIAL_TABLE_ID=
FEISHU_VN_RENDER_APP_TOKEN=
FEISHU_VN_RENDER_TABLE_ID=
FEISHU_VN_PUBLISH_TABLE_ID=
FEISHU_VN_ACCOUNT_TABLE_ID=
FEISHU_VN_PRODUCT_TABLE_ID=
FEISHU_VN_ANALYTICS_TABLE_ID=
FEISHU_VN_RENDER_MATERIAL_MAP_TABLE_ID=
FEISHU_VN_CONTRIBUTION_TABLE_ID=
FEISHU_VN_JOB_LOG_TABLE_ID=

# ===== OneDrive（Microsoft Graph 设备码登录）=====
ONEDRIVE_CLIENT_ID=cf9e61b0-87c2-46f1-85f6-bb144b8e7085
ONEDRIVE_TENANT_ID=n9i0.onmicrosoft.com
ONEDRIVE_TARGET_FOLDER=/04.AI Center/KOL VIDEO/03.VN
ONEDRIVE_SCOPES=https://graph.microsoft.com/Files.ReadWrite
ONEDRIVE_AUTH_RECORD_PATH=data/onedrive/auth_record.json
ONEDRIVE_TOKEN_CACHE_NAME=ai_video_onedrive_cache
ONEDRIVE_LINK_TYPE=view
ONEDRIVE_LINK_SCOPE=anonymous

# ===== 评分 / 归因 / 选材 引擎参数（默认值，可调）=====
# 成片综合表现分权重
PERF_WEIGHT_COMPLETION=0.30
PERF_WEIGHT_ENGAGEMENT=0.25
PERF_WEIGHT_VIEWS=0.15
PERF_WEIGHT_GMV=0.30
# 探索比例 epsilon：起始 -> 下限
SELECTION_EPSILON_START=0.30
SELECTION_EPSILON_FLOOR=0.10
# 成片目标时长（秒）与允许超出比例
SELECTION_TARGET_DURATION_SEC=25
SELECTION_MAX_OVERSHOOT=1.25

# 成片上传到的 OneDrive 目录（与素材目录分开）
ONEDRIVE_RENDER_FOLDER=/04.AI Center/KOL VIDEO/03.VN/_AI_Renders
# 评分置信度平滑常数 k
SCORING_SHRINK_K=5
# 素材冷启动乐观初始分
SCORING_OPTIMISTIC_INIT=0.60
