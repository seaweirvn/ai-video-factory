# ===== 服务 =====
APP_NAME=ai-video-factory
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# 控制层调用服务层时携带的密钥（n8n -> API）
API_KEY=change-me

# ===== 工作区 / 数据目录 =====
WORKSPACE_DIR=workspace
LOG_DIR=logs
DATA_DIR=data

# ===== 飞书（当前 VN，后续国家按 FEISHU_{CODE}_* 扩展）=====
FEISHU_VN_APP_ID=your_feishu_vn_app_id
FEISHU_VN_APP_SECRET=your_feishu_vn_app_secret
FEISHU_VN_BITABLE_APP_TOKEN=your_vn_bitable_app_token
# 素材库在“营销”知识库多维表格下（app_token 与主 bitable 不同；可用脚本 wikifields 解析 wiki 节点得到）
FEISHU_VN_MATERIAL_APP_TOKEN=
# 各业务表 ID
FEISHU_VN_MATERIAL_TABLE_ID=
FEISHU_VN_RENDER_APP_TOKEN=
FEISHU_VN_RENDER_TABLE_ID=
# 成片=发布合表：中国（用于中文孪生版；留空则不产中文版）。评分脚本按 FEISHU_CN_* 自动出 CN评分
FEISHU_CN_RENDER_APP_TOKEN=
FEISHU_CN_RENDER_TABLE_ID=
# 成片表与发布表可用同一张表：把 PUBLISH_TABLE_ID 填成与 RENDER_TABLE_ID 相同即可，
# 发布结果会按平台回写到该成片所在行（TikTok/Shopee 发布状态与链接等列自动创建）
FEISHU_VN_PUBLISH_TABLE_ID=
# 发布表 app_token（留空则默认用成片表/主 bitable 的 app_token）
FEISHU_VN_PUBLISH_APP_TOKEN=
FEISHU_VN_ACCOUNT_TABLE_ID=
# 账号表 app_token（留空则默认用成片表/主 bitable 的 app_token）
FEISHU_VN_ACCOUNT_APP_TOKEN=
FEISHU_VN_PRODUCT_TABLE_ID=
# 产品中心表 app_token（留空则默认用素材库/主 bitable 的 app_token）
FEISHU_VN_PRODUCT_APP_TOKEN=
FEISHU_VN_ANALYTICS_TABLE_ID=
FEISHU_VN_RENDER_MATERIAL_MAP_TABLE_ID=
FEISHU_VN_CONTRIBUTION_TABLE_ID=
FEISHU_VN_JOB_LOG_TABLE_ID=

# ===== OneDrive（Microsoft Graph 设备码登录）=====
ONEDRIVE_CLIENT_ID=cf9e61b0-87c2-46f1-85f6-bb144b8e7085
ONEDRIVE_TENANT_ID=n9i0.onmicrosoft.com
ONEDRIVE_TARGET_FOLDER=/04.AI Center/KOL VIDEO/03.VN
ONEDRIVE_SCOPES=https://graph.microsoft.com/Files.ReadWrite
ONEDRIVE_AUTH_RECORD_PATH=data/onedrive/auth_record.json
ONEDRIVE_TOKEN_CACHE_NAME=ai_video_onedrive_cache
ONEDRIVE_LINK_TYPE=view
ONEDRIVE_LINK_SCOPE=anonymous

# ===== Cloudflare R2（目录前缀按实际对象结构填写）=====
# 完成素材链接迁移和生产验证前保持 onedrive；正式切换时改为 r2。
STORAGE_PROVIDER=onedrive
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=
R2_MATERIAL_PREFIX=video-clips
R2_RENDER_PREFIX=video-global/03-VN/AI-VIDEO
R2_KOL_PREFIX=video-global/03-VN/KOL-VIDEO

# ===== 评分 / 归因 / 选材 引擎参数（默认值，可调）=====
# 成片综合表现分权重
PERF_WEIGHT_COMPLETION=0.30
PERF_WEIGHT_ENGAGEMENT=0.25
PERF_WEIGHT_VIEWS=0.15
PERF_WEIGHT_GMV=0.30
# 探索比例 epsilon：起始 -> 下限
SELECTION_EPSILON_START=0.30
SELECTION_EPSILON_FLOOR=0.10
# 成片目标时长（秒）与允许超出比例
SELECTION_TARGET_DURATION_SEC=25
SELECTION_MAX_OVERSHOOT=1.25

# 成片上传到的 OneDrive 目录（与素材目录分开）
ONEDRIVE_RENDER_FOLDER=/04.AI Center/KOL VIDEO/03.VN/_AI_Renders

# KOL 原始视频下载（独立链路：飞书创作者表 -> TikWM -> OneDrive -> 归档；与 AI 剪辑无关）
FEISHU_VN_KOL_VIDEO_TABLE_ID=
# KOL 表所在 bitable app_token（留空则回退 FEISHU_VN_BITABLE_APP_TOKEN）
FEISHU_VN_KOL_APP_TOKEN=
KOL_DOWNLOAD_DIR=data/kol/videos
KOL_ARCHIVE_DIR=data/kol/archive
# Windows SYSTEM 计划任务建议填写 ffprobe.exe 的绝对路径
FFPROBE_PATH=
KOL_DOWNLOAD_TIMEOUT_SEC=420
# KOL 原始视频上传的国家根目录；按月份放到 {根}/{YYYY-MM}/ 下（其他国家改这个根目录）
ONEDRIVE_KOL_FOLDER=/04.AI Center/KOL VIDEO/03.VN
# 评分置信度平滑常数 k
SCORING_SHRINK_K=5
# 素材冷启动乐观初始分
SCORING_OPTIMISTIC_INIT=0.60

# ===== AI 文案（OpenAI 兼容接口）=====
# ai_provider: auto=有 key 用 OpenAI 否则模板; openai=强制; null=只用模板
AI_PROVIDER=auto
CONTENT_LANGUAGE=vi
# 目标国家（多国扩展用）
CONTENT_COUNTRY=VN
# 中文孪生版：每产一条越南版后，用同一选材/结构再产中文版（中文字幕+中文配音），写入「中国」表
CN_TWIN_ENABLED=false
CN_CONTENT_LANGUAGE=zh
CN_VOICE_PROFILE=cn_female_01
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 配音（TTS）+ 字幕（默认关闭；配音需要 OPENAI_API_KEY）=====
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
VOICEOVER_ENABLED_DEFAULT=false
VOICEOVER_SUBTITLE_DEFAULT=true
# “保留原声”片段的原声混入音量（0~1，默认 1.0：不压低）
VOICEOVER_KEPT_ORIGINAL_VOLUME=1.0
# 选材目标时长在配音时长上加的余量（秒）
VOICEOVER_TAIL_MARGIN_SEC=1.5

# ===== 真人化配音（可插拔 Provider + 主播口语 + 逐句合成）=====
# voice_provider: auto=有 openai key 用 openai 否则 edge; openai | edge | elevenlabs | cartesia | minimax
VOICE_PROVIDER=auto
# 音色档：留空=按国家自动选（不同国家不同声音，见 COUNTRY_VOICE_PROFILE）；填档名可强制覆盖
VOICE_PROFILE=
# 情绪风格：normal | happy | excited | review | live
VOICE_STYLE=live
# 每句随机语速区间
VOICE_SPEED_MIN=1.0
VOICE_SPEED_MAX=1.0
# 每句随机音高（百分比整数，取 [-x, x]）
VOICE_PITCH_RANDOM=0
# 停顿随机抖动（毫秒，±x）
VOICE_PAUSE_RANDOM=0
# ElevenLabs / Cartesia（切换到对应 Provider 时才需要）
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai
# MiniMax（海螺）T2A：Bearer 鉴权，T2A 合成不需要 GroupId
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=speech-2.6-hd
# 语言增强，提升小语种发音（如 Vietnamese）；auto 为自动
MINIMAX_LANGUAGE_BOOST=auto

# ===== BGM 背景音乐（自动在线选曲 + 本地音乐库 + GMV 打分复用，默认关闭）=====
# 开启后按「国家 + 情绪」在线检索可商用曲、下载到本地音乐库；后续按 GMV 分优先复用高分曲。
# 失败/超时/无 key 静默回落本地/无 BGM，绝不打断成片。
BGM_ONLINE_ENABLED=false
# provider: jamendo（免费，推荐）| magnific（付费订阅，备用）
BGM_ONLINE_PROVIDER=jamendo
BGM_ONLINE_TIMEOUT_SEC=15
# Jamendo client_id（devportal.jamendo.com 免费注册）；只取 CC-BY 可商用曲，署名自动带出
JAMENDO_CLIENT_ID=
# Magnific Music API key（付费订阅，备用；docs.magnific.com）
MAGNIFIC_API_KEY=
MAGNIFIC_BASE_URL=https://api.magnific.com
# 每条视频加 BGM 的概率（0~1）：默认 0.5 = 每次剪辑 50% 概率开/关背景音乐
DIRECTOR_BGM_PROBABILITY=0.5
# 选曲探索率 ε：ε 概率拉新曲扩库，其余按 GMV 分复用库内高分曲
DIRECTOR_BGM_EXPLORE_EPSILON=0.25

# ===== 发布（第三方聚合工具；未配置走 stub 只记录不真发）=====
# publish_provider: auto=配了 key 用第三方 否则 stub; thirdparty=强制; stub=只记录
PUBLISH_PROVIDER=auto
PUBLISH_BASE_URL=
PUBLISH_API_KEY=
PUBLISH_PLATFORM=tiktok
# 每账号每天发布条数区间 + 白天错峰时段（小时）
PUBLISH_PER_ACCOUNT_MIN=3
PUBLISH_PER_ACCOUNT_MAX=5
PUBLISH_WINDOW_START_HOUR=9
PUBLISH_WINDOW_END_HOUR=21
# 账号表就绪前的临时账号列表（逗号分隔），/publish/schedule/auto 用
PUBLISH_ACCOUNTS=

# ===== 比特浏览器真人式发布（PUBLISH_PROVIDER=bitbrowser 时启用）=====
BITBROWSER_API_URL=http://127.0.0.1:54345
# 账号 -> 比特环境ID 映射，形如 tt_vn_01:环境ID1,tt_vn_02:环境ID2（环境需已手动登录 TikTok）
BITBROWSER_ACCOUNT_MAP=
BITBROWSER_UPLOAD_URL=https://www.tiktok.com/tiktokstudio/upload
BITBROWSER_UPLOAD_TIMEOUT=300
BITBROWSER_ACTION_DELAY_MIN_MS=400
BITBROWSER_ACTION_DELAY_MAX_MS=1200
# 发布完成后是否保留比特窗口不关闭（调试/人工复核置 true）
BITBROWSER_KEEP_OPEN=false
# 产品→窗口路由配置（每窗=一个比特环境，含 TK+Shopee）。窗口/地区在此文件里加，代码不动
PUBLISH_ROUTING_FILE=data/publish_routing.json
